<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>BundlingPoc</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GdPicture.API" Version="14.4.7" />
    <PackageReference Include="GdPicture.Resources" Version="1.0.1" />
    <PackageReference Include="GdPicture.Runtimes.MacOS" Version="14.4.7" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
    <PackageReference Include="GdPicture.Runtimes.Windows" Version="14.4.7" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <PackageReference Include="GdPicture.Runtimes.Linux" Version="14.4.7" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
    <PackageReference Include="MsgReader" Version="6.1.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

</Project>
